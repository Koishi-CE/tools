{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "koishi-plugin-cleanscreen",
    "version": "1.3.0",
    "description": "机器人必须是群主，通过撤回消息来（暴力）清屏",
    "contributors": [
        "Oppenheymu <oppenheymu@gmail.com>"
    ],
    "type": "module",
    "main": "lib/index.cjs",
    "module": "lib/index.mjs",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "development": "./src/index.ts",
            "import": "./lib/index.mjs",
            "require": "./lib/index.cjs",
            "default": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Koishi-CE/tools.git",
        "directory": "packages/clean-screen"
    },
    "bugs": {
        "url": "https://github.com/Koishi-CE/tools/issues"
    },
    "homepage": "https://github.com/Koishi-CE/tools/tree/main/packages/clean-screen",
    "keywords": [
        "chatbot",
        "koishi",
        "plugin",
        "clear",
        "clean"
    ],
    "koishi": {
        "description": {
            "en": "Clear the screen by unsending messages",
            "zh": "机器人必须是群主，通过撤回消息来（暴力）清屏"
        },
        "service": {}
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check . && tsc --noEmit",
        "fix": "biome check --write . && tsc --noEmit"
    },
    "peerDependencies": {
        "koishi": "^4.18.7",
        "koishi-plugin-adapter-onebot": "^6.0.0"
    },
    "devDependencies": {
        "koishi": "^4.18.7"
    }
}
